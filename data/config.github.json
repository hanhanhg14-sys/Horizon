{
  "ai": {
    "provider": "openai",
    "model": "glm-4.7-flash",
    "base_url": "https://open.bigmodel.cn/api/paas/v4",
    "api_key_env": "ZHIPU_API_KEY",
    "throttle_sec":1.0,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 6.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 4.0,
        "topic_dedup": false
      },
      "finance-news": {
        "threshold": 7.0,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 100,
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "CISA 全部安全公告",
        "url": "https://www.cisa.gov/cybersecurity-advisories/all.xml",
        "enabled": true,
        "category": "policy-advisory",
        "profile": "tech-news"
      },
      {
        "name": "NIST Cybersecurity Insights",
        "url": "https://www.nist.gov/blogs/cybersecurity-insights/rss.xml",
        "enabled": true,
        "category": "policy-advisory",
        "profile": "tech-news"
      },
      {
        "name": "ENISA 出版物",
        "url": "https://www.enisa.europa.eu/publications/rss",
        "enabled": false,
        "category": "policy-advisory",
        "profile": "tech-news"
      },
      {
        "name": "SANS ISC 日记",
        "url": "https://isc.sans.edu/rssfeed_full.xml",
        "enabled": true,
        "category": "incident-analysis",
        "profile": "tech-news"
      },
      {
        "name": "DysruptionHub 关键基础设施事件",
        "url": "https://dysruptionhub.com/rss/",
        "enabled": true,
        "category": "critical-infrastructure",
        "profile": "tech-news"
      },
      {
        "name": "Case Library 关键基础设施专项",
        "url": "https://cybercaselibrary.com/feeds/critical-infrastructure.xml",
        "enabled": true,
        "category": "critical-infrastructure",
        "profile": "tech-news"
      },
      {
        "name": "Case Library 勒索软件专项",
        "url": "https://cybercaselibrary.com/feeds/ransomware.xml",
        "enabled": true,
        "category": "ransomware",
        "profile": "tech-news"
      },
      {
        "name": "Case Library 国家级/APT专项",
        "url": "https://cybercaselibrary.com/feeds/nation-state.xml",
        "enabled": true,
        "category": "apt-nation-state",
        "profile": "tech-news"
      },
      {
        "name": "cve.now 全部漏洞（含KEV/EPSS）",
        "url": "https://cve.now/feed",
        "enabled": false,
        "category": "vulnerability",
        "profile": "tech-news"
      },
      {
        "name": "cve.now 新收录的 CISA KEV",
        "url": "https://cve.now/feed?filter=kev",
        "enabled": true,
        "category": "vulnerability-kev",
        "profile": "tech-news"
      },
      {
        "name": "CIRCL NVD 最新CVE镜像",
        "url": "https://vulnerability.circl.lu/recent/nvd.rss",
        "enabled": true,
        "category": "vulnerability",
        "profile": "tech-news"
      },
      {
        "name": "SecConHub 安全会议聚合",
        "url": "https://conferences.seclens.info/rss/",
        "enabled": false,
        "category": "conference",
        "profile": "tech-news"
      },
      {
        "name": "Bleeping Computer",
        "url": "https://www.bleepingcomputer.com/feed/",
        "enabled": true,
        "category": "cybersecurity",
        "profile": "tech-news"
      },
      {
        "name": "The Hacker News",
        "url": "https://feeds.feedburner.com/TheHackersNews",
        "enabled": true,
        "category": "cybersecurity",
        "profile": "tech-news"
      },
      {
        "name": "Krebs on Security",
        "url": "https://krebsonsecurity.com/feed/",
        "enabled": true,
        "category": "cybersecurity",
        "profile": "tech-news"
      },
      {
        "name": "CISA Advisories",
        "url": "https://www.cisa.gov/cybersecurity-advisories/all.xml",
        "enabled": true,
        "category": "cybersecurity",
        "profile": "tech-news"
      },
      {
        "name": "SecurityWeek",
        "url": "https://www.securityweek.com/feed/",
        "enabled": true,
        "category": "cybersecurity",
        "profile": "tech-news"
      },
      {
        "name": "Dark Reading",
        "url": "https://www.darkreading.com/rss.xml",
        "enabled": true,
        "category": "cybersecurity",
        "profile": "tech-news"
      },
      {
        "name": "The Record",
        "url": "https://therecord.media/feed",
        "enabled": true,
        "category": "cybersecurity",
        "profile": "tech-news"
      },
      {
        "name": "安全客",
        "url": "https://api.anquanke.com/data/v1/rss",
        "enabled": true,
        "category": "cybersecurity-cn",
        "profile": "tech-news"
      },
      {
        "name": "FreeBuf",
        "url": "https://www.freebuf.com/feed",
        "enabled": false,
        "category": "cybersecurity-cn",
        "profile": "tech-news"
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [
        {
          "subreddit": "netsec",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 30,
          "profile": "tech-news"
        },
        {
          "subreddit": "cybersecurity",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 30,
          "profile": "tech-news"
        },
        {
          "subreddit": "blueteamsec",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 20,
          "profile": "tech-news"
        },
        {
          "subreddit": "hacking",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 20,
          "profile": "tech-news"
        }
      ],
      "users": [],
      "fetch_comments": 10
    },
    "telegram": {
      "enabled": false,
      "channels": []
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": null,
    "profile_order": [
      "tech-news",
      "tech-blog",
      "finance-news"
    ],
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "#{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  }
}
